{
  "headers": [
    {
      "source": "/maps/(.*).pmtiles",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=31536000, immutable"
        }
      ]
    }
  ]
}
